# Copier en .env pour surcharger les valeurs par défaut de docker-compose
DB_NAME=taskora
DB_USER=taskora
DB_PASSWORD=taskora
DB_ROOT_PASSWORD=taskora_root
APP_SECRET=change_me_in_production_please
JWT_PASSPHRASE=taskora_jwt_passphrase_change_me
# Ports publiés sur l'hôte et adresse d'écoute (BIND) de chaque service.
# BIND = 127.0.0.1 : accessible depuis cette machine seulement ; 0.0.0.0 : depuis tout le réseau.
WEB_BIND=0.0.0.0
WEB_PORT=8080
# Garder 127.0.0.1 : l'endpoint interne /internal/* ne doit pas être joignable depuis le réseau.
API_BIND=127.0.0.1
API_PORT=8081
DB_BIND=127.0.0.1
DB_PORT=3307

# Le stockage des images (Amazon S3) et les autres réglages de Symfony
# se configurent dans backend/.env (modèle : backend/.env.dist)

# identity-service (profil compose « identity ») — valeurs FACTICES, à remplacer dans .env
# Mot de passe du compte MariaDB « identity » (créé par docker/mariadb/initdb.d/10-taskora-init.sh)
IDENTITY_DB_PASSWORD=identity_change_me
# Secret partagé de POST /internal/invitations/claim (api ↔ identity). Générer : openssl rand -hex 32
INTERNAL_API_SECRET=change_me_internal_api_secret
# Port d'identity-service avec docker-compose.identity-dev.yml
IDENTITY_BIND=127.0.0.1
IDENTITY_PORT=8082
# Amont nginx de /api/auth/ et /api/me : api:80 (Symfony) ou identity:8080 (après bascule)
IDENTITY_UPSTREAM=api:80
# Gel des écritures d'identité pendant la bascule : on | off
IDENTITY_WRITE_FREEZE=off
# Port de SonarQube (profil compose « quality »)
SONAR_BIND=127.0.0.1
SONAR_PORT=9000

# board-service (profil compose « board », phase 3) — valeurs FACTICES et toutes DIFFÉRENTES, à remplacer dans .env
# Mot de passe du compte MariaDB « board » (créé par docker/mariadb/initdb.d/10-taskora-init.sh ; vide = compte non créé)
BOARD_DB_PASSWORD=board_change_me
# Secrets internes par appelant (U12) : générer chacun avec openssl rand -hex 32, jamais deux valeurs égales.
#   INTERNAL_API_SECRET (ci-dessus) : identity → Symfony (claim des invitations)
#   identity → board-service (claim des invitations après la bascule de T1)
INTERNAL_SECRET_IDENTITY_TO_BOARD=change_me_identity_to_board
#   board-service → Symfony (/internal/notifications, puis stockage et miniatures)
INTERNAL_SECRET_BOARD_TO_SYMFONY=change_me_board_to_symfony
# Consommation des invitations par identity : URL et secret commutés ENSEMBLE, puis « docker compose up -d identity ».
#   avant la bascule de T1 : vides = http://api:80 et la valeur de INTERNAL_API_SECRET (défauts)
#   après la bascule de T1 : http://board:8080 et la valeur de INTERNAL_SECRET_IDENTITY_TO_BOARD
INVITATION_CLAIM_URL=
INVITATION_CLAIM_SECRET=
# Port de board-service avec docker-compose.board-dev.yml
BOARD_BIND=127.0.0.1
BOARD_PORT=8083
# Amont nginx de chaque tranche : api:80 (Symfony) ou board:8080 (après bascule) ; puis « docker compose up -d web »
BOARD_T1_UPSTREAM=api:80
BOARD_T2_UPSTREAM=api:80
BOARD_T3_UPSTREAM=api:80
BOARD_T4_UPSTREAM=api:80
BOARD_T5_UPSTREAM=api:80
# En-tête X-Taskora-Backend: board (tests de routage, CI et recette) : on | off (off en exploitation)
BOARD_ROUTING_MARKER=off
# Droit INSERT de board sur taskora.attachment (fichiers de commentaire, T4 seulement) : on | off
BOARD_GRANT_COMMENT_FILES=off
