# Copier en .env pour surcharger les valeurs par défaut de docker-compose
DB_NAME=taskora
DB_USER=taskora
DB_PASSWORD=taskora
DB_ROOT_PASSWORD=taskora_root
APP_SECRET=change_me_in_production_please
JWT_PASSPHRASE=taskora_jwt_passphrase_change_me
WEB_PORT=8080
API_PORT=8081
DB_PORT=3307

# Le stockage des images (Amazon S3) et les autres réglages de Symfony
# se configurent dans backend/.env (modèle : backend/.env.dist)

# identity-service (profil compose « identity ») — valeurs FACTICES, à remplacer dans .env
# Mot de passe du compte MariaDB « identity » (créé par docker/mariadb/initdb.d/10-taskora-init.sh)
IDENTITY_DB_PASSWORD=identity_change_me
# Secret partagé de POST /internal/invitations/claim (api ↔ identity). Générer : openssl rand -hex 32
INTERNAL_API_SECRET=change_me_internal_api_secret
# Port local (127.0.0.1) d'identity-service avec docker-compose.identity-dev.yml
IDENTITY_PORT=8082
# Amont nginx de /api/auth/ et /api/me : api:80 (Symfony) ou identity:8080 (après bascule)
IDENTITY_UPSTREAM=api:80
# Gel des écritures d'identité pendant la bascule : on | off
IDENTITY_WRITE_FREEZE=off
# Port local de SonarQube (profil compose « quality »)
SONAR_PORT=9000
