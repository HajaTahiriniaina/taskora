# Environnement de test PHPUnit : valeurs FACTICES uniquement (aucune clé AWS ni VAPID).
# Les vraies variables d'environnement (docker compose run -e …) l'emportent sur ce fichier.
KERNEL_CLASS='App\Kernel'
APP_SECRET=test-app-secret-not-a-real-secret-0000
INTERNAL_API_SECRET=test-internal-secret-0123456789abcdef
# Base dédiée aux tests : doctrine.yaml (when@test) ajoute le suffixe « _test » au nom de base,
# donc …/taskora désigne taskora_test (créée par Manuel, voir docs/ci/requests/backend.md).
# Valeur factice, surchargée par la variable d'environnement réelle (-e DATABASE_URL=…).
DATABASE_URL="mysql://taskora:taskora@database:3306/taskora?serverVersion=11.8.2-MariaDB&charset=utf8mb4"
